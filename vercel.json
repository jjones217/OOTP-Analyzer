{
  "headers": [
    {
      "source": "/statsplus-api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "s-maxage=60, stale-while-revalidate=120" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/statsplus-api/:lgurl/:endpoint",
      "destination": "https://statsplus.net/:lgurl/api/:endpoint"
    },
    {
      "source": "/((?!statsplus-api/).*)",
      "destination": "/index.html"
    }
  ]
}
